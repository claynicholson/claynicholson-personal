# ── Status page (/status) ─────────────────────────────────────────────────────
# The status page reads your Coolify deployments server-side. The token is
# never exposed to the browser.

# Base URL of your Coolify instance (no trailing slash).
COOLIFY_API_URL=https://coolify.claynicholson.com

# A READ-scoped API token (Coolify → Keys & Tokens → API tokens).
# Use the least-privileged token possible; do NOT grant read:sensitive.
COOLIFY_API_TOKEN=

# Optional: only expose specific projects on the public page. Comma-separated
# project names (substring match). Leave empty to show all projects.
# STATUS_PROJECT_ALLOWLIST=ASICify,Copper,Personal Site

# Optional: enable the cron snapshot endpoint (/api/status/snapshot). When set,
# point a scheduler at it for evenly-spaced uptime history, e.g.:
#   curl -fsS -H "x-cron-secret: $STATUS_CRON_SECRET" https://claynicholson.com/api/status/snapshot
# If unset, history still self-populates from organic page views.
# STATUS_CRON_SECRET=

# Optional: where uptime history is persisted. Point at a persistent volume in
# production so history survives redeploys. Defaults to ./.data
# STATUS_DATA_DIR=/data

# Optional tuning (defaults shown):
# STATUS_SNAPSHOT_INTERVAL_MS=300000   # min spacing between recorded snapshots
# STATUS_WINDOW_MS=2592000000          # graph window (30 days)
# STATUS_BUCKETS=90                    # number of bars
# STATUS_CACHE_TTL_MS=20000            # how long /api/status is cached
# STATUS_RETENTION_MS=7776000000       # history kept (90 days)
